# Copy to .env and fill in. Never commit .env.

# CollegeFootballData.com API key (free): FBS teams, schedules, scores, lines.
CFBD_API_KEY=

# Supabase project settings > API keys (new key format).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=   # sb_publishable_...  safe for the browser, read-only via RLS
SUPABASE_SECRET_KEY=        # sb_secret_...       server and jobs only

# Supabase > Connect > "Session pooler" connection string (works over IPv4,
# which GitHub Actions needs). Used by Python jobs and migrations.
DATABASE_URL=
